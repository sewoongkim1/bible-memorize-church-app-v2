#!/bin/sh
# 푸시 전에 preflight — 깨진 판이 main 에 올라가 모든 세션의 배포를 막는 일을 막는다(2026-10-12).
#   이 저장소는 푸시 = 배포다. Actions 도 같은 검사를 돌리지만, 거기서 걸리면 이미 main 이 깨진 뒤라
#   다른 세션의 배포까지 멈춘다(2026-10-04~05 다섯 번). 여기서 먼저 막는다.
# 켜기(체크아웃마다 한 번): git config core.hooksPath .githooks
# 정말 급할 때만 건너뛰기: git push --no-verify  (그 뒤 바로 preflight 를 손으로 돌릴 것)
#
# main 으로 가는 푸시만 본다 — 작업 가지를 올려 두는 것까지 막지는 않는다.
need=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) need=1 ;;
  esac
done
[ "$need" = 1 ] || exit 0

root=$(git rev-parse --show-toplevel) || exit 1
# ⚠️ 윈도에는 「python3」 이름의 가짜(스토어 안내용)가 있어 이름만 보고 고르면 「Python」 한 줄 찍고 실패한다 — 실제로 돌려 보고 고른다.
PY=""
for c in python python3 py; do
  if "$c" -c "import sys" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-push: python 을 못 찾아 preflight 를 건너뛴다 — 손으로 python tools/preflight.py 를 돌릴 것" >&2
  exit 0
fi
echo "pre-push: main 으로 올리기 전에 preflight 를 돌린다…" >&2
if ! "$PY" "$root/tools/preflight.py" >&2; then
  echo "" >&2
  echo "pre-push: preflight 가 걸려 푸시를 멈췄다. 위 내용을 고친 뒤 다시 올릴 것." >&2
  exit 1
fi
exit 0
