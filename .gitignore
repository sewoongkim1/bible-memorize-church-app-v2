# 의존성
node_modules/
# 환경변수/비밀 (Supabase 키 등 — 절대 커밋 금지)
.env
.env.*
!.env.example
# 빌드 산출물
dist/
build/
# Supabase CLI 로컬 상태
supabase/.temp/
supabase/.branches/
# OS/에디터
.DS_Store
Thumbs.db
.vscode/
# 이관 덤프(개인정보) — 커밋 금지
migrate/v1dump.json
# 내부 문서(공개 저장소에 포함하지 않음)
보고서_*.html
추가제안_*.html
기술구조제안_*.html
기획서_*.html
기획서_*.pdf
# 홍보 영상 원본 클립(용량이 크고 편집 전 소재) — 커밋 금지
marketing/scenes/
# 작업 중 임시 파일
_assets.tmp
mock.py
booklet-mock.html
*.pptx
# 홍보 영상용 실기기 화면 캡처(실제 성도 이름·순위 등 개인정보 포함 — 커밋 금지)
/Picture/

# 앱 서명 키 — 절대 커밋 금지.
# 이 저장소는 공개다. 키와 비밀번호가 새면 누구나 이 앱 이름으로 가짜 업데이트를
# 서명할 수 있고, 우리는 그것을 막을 방법이 없다.
# 잃어버려도 큰일이다 — 그 앱을 두 번 다시 업데이트할 수 없다.
# → 저장소 밖(구글 드라이브 비공개 폴더·USB 등)에 두 파일을 짝으로 보관할 것.
*.keystore
*.jks
signing-key-info.txt
# 앱 패키지 산출물(용량이 크고 매번 다시 만들 수 있다)
*.aab
*.apk
# PWABuilder 패키지 — 안에 서명 키와 비밀번호가 들어 있다. 절대 커밋 금지.
*Google Play package*

# ─────────────────────────────────────────────────────────────
# 성경 본문 원문(개역개정) — 대조·검사용으로 내려받아 둔 것.
# ⚠️ 이 저장소는 **공개**다. 개역개정 전문은 대한성서공회 저작물이라
#    통째로 올리면 저작권 문제가 된다. 3.6MB · 66권.
#    앱이 쓰는 구절은 DB(verses·blessings)에 있고 이 폴더는 필요 없다.
bible/

# 캡처·측정하다 남는 임시 파일
#   tools/capture-guide-shots.py 가 index.html 에 씨앗을 끼워 _cap.html 을 만든다.
#   정상 종료하면 지우지만 중간에 끊기면 남는다.
/_*.html
_lh_tmp.html
_probe.html

# 파이썬 부산물 (importlib 로 tools/*.py 를 부르면 생긴다)
__pycache__/
*.pyc

# 엑셀이 파일을 열어 두는 동안 만드는 잠금 파일
~$*.xlsx
~$*.docx

# 원본 기도문 엑셀 — 손본 것(가정축복기도문_수정.xlsx)이 진짜 자료다.
#   개역개정 대조로 고치기 **전** 판이라 이걸 보면 틀린 본문을 보게 된다.
marketing/가정축복기도문.xlsx

# 로컬 실행 로그
*.log

# ─── 추적에서 뺀 것들(파일은 그대로 둔다) ────────────────────────
# ⚠️ 같은 15.7MB PDF 가 두 군데 있었다. 이벤트 자산은 event-posters/ 에 모으므로
#    그쪽만 남긴다. 바깥 것은 사본이었다(해시 동일).
/marketing/말씀암송이벤트_32구절(광고).pdf
# 손보기 전 판을 남겨 둔 것 — 저장소가 들고 있을 이유가 없다(5.7MB)
booklet/*_backup.pdf
# 캡처를 돌릴 때마다 다시 쓰이는 기록 — 볼 사람이 없는데 git status 만 지저분해진다
guide/_cap.txt

# 축복기도문 핸드북 — 이름이 박힌 개인용 산출물(생성기로 언제든 다시 만든다)
booklet/축복기도문_*.html
booklet/축복기도문_*_*.pdf
# 줄나눔은 사람이 손으로 고치는 파일 — 만든 사람 것이라 저장소에 넣지 않는다
#   (필요하면 이 줄을 지우고 함께 관리해도 된다)
booklet/줄나눔.txt
# ⚠️ 명단은 성도님 성함이다 — 공개 저장소에 올리지 않는다.
#    견본이 필요하면 명단뽑기.bat 안내대로 직접 만들면 된다(한 줄에 한 분).
booklet/명단.txt
# 명단으로 뽑은 산출물 폴더(사람마다 이름이 박힌 HTML·PDF)
booklet/출력/
