# 의존성
node_modules/
# 환경변수/비밀 (Supabase 키 등 — 절대 커밋 금지)
.env
.env.*
!.env.example
# 빌드 산출물
dist/
build/
# Supabase CLI 로컬 상태
supabase/.temp/
supabase/.branches/
# OS/에디터
.DS_Store
Thumbs.db
.vscode/
# 이관 덤프(개인정보) — 커밋 금지
migrate/v1dump.json
# 내부 문서(공개 저장소에 포함하지 않음)
보고서_*.html
추가제안_*.html
기술구조제안_*.html
기획서_*.html
기획서_*.pdf
# 홍보 영상 원본 클립(용량이 크고 편집 전 소재) — 커밋 금지
marketing/scenes/
# 작업 중 임시 파일
_assets.tmp
mock.py
booklet-mock.html
*.pptx
# 홍보 영상용 실기기 화면 캡처(실제 성도 이름·순위 등 개인정보 포함 — 커밋 금지)
/Picture/

# 앱 서명 키 — 절대 커밋 금지.
# 이 저장소는 공개다. 키와 비밀번호가 새면 누구나 이 앱 이름으로 가짜 업데이트를
# 서명할 수 있고, 우리는 그것을 막을 방법이 없다.
# 잃어버려도 큰일이다 — 그 앱을 두 번 다시 업데이트할 수 없다.
# → 저장소 밖(구글 드라이브 비공개 폴더·USB 등)에 두 파일을 짝으로 보관할 것.
*.keystore
*.jks
signing-key-info.txt
# 앱 패키지 산출물(용량이 크고 매번 다시 만들 수 있다)
*.aab
*.apk
